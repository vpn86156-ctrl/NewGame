{
  "name": "terra-chronicle",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "npm run build:offline && vite build && python scripts/generate_sw.py dist",
    "build:offline": "vite build --config vite.offline.config.js && python scripts/package_offline.py",
    "build:online": "vite build && python scripts/generate_sw.py dist",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.2.6",
    "@fontsource/russo-one": "^5.2.6",
    "framer-motion": "^12.23.12",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^6.1.0",
    "vite-plugin-singlefile": "^2.3.4"
  }
}
